# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio → API keys).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production URL of this service (e.g. https://the-frame-shop.up.railway.app).
APP_URL="MY_APP_URL"

# SHOP_OWNER_PIN: The 4-digit PIN used to unlock the Shop Admin Portal.
# Set this to a real PIN in production — do NOT leave as 1234.
SHOP_OWNER_PIN="1234"

# SHOP_API_SECRET: Long random string used as the bearer token for admin API routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match between server env and be returned to the client after PIN validation.
SHOP_API_SECRET="generate-a-64-char-random-hex-string-here"

# ---------------------------------------------------------------------------
# Payments — Shopify
#
# Deposits and job invoices are both Shopify Draft Orders. Create a custom app
# in the Shopify admin (Settings -> Apps and sales channels -> Develop apps),
# give it write_draft_orders and read_orders, then install it to get the token.
# ---------------------------------------------------------------------------

# SHOPIFY_STORE_DOMAIN: the myshopify address, no https:// and no trailing slash.
SHOPIFY_STORE_DOMAIN="theframeshop.myshopify.com"

# SHOPIFY_ADMIN_TOKEN: Admin API access token from that custom app (shpat_...).
# SERVER ONLY — it can read orders and customers, so never expose it to the
# frontend or put it in a VITE_ prefixed variable.
SHOPIFY_ADMIN_TOKEN="shpat_..."

# SHOPIFY_WEBHOOK_SECRET: Shopify admin -> Settings -> Notifications -> Webhooks.
# Create an "Order payment" (orders/paid) webhook pointing at:
#   https://your-domain.com/api/shopify/webhook
# then copy the signing secret shown there. Without it every webhook is
# rejected, and jobs will never be marked paid.
SHOPIFY_WEBHOOK_SECRET="your-webhook-signing-secret"

# SHOPIFY_API_VERSION: optional. Defaults to 2024-10.
SHOPIFY_API_VERSION="2024-10"

# ---------------------------------------------------------------------------
# Shop video hosting (optional)
#
# Set these to let Paul upload video files from the Owner Photo Control tab.
# Leave them blank and the video section still works — he just adds videos by
# pasting a YouTube or Vimeo link instead of uploading.
# ---------------------------------------------------------------------------

# SUPABASE_URL: Project URL from Supabase Dashboard → Project Settings → API.
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_SERVICE_KEY: service_role key from the same page. SERVER ONLY —
# it bypasses row level security, so it must never appear in frontend code or
# any VITE_ prefixed variable.
SUPABASE_SERVICE_KEY="your-service-role-key"

# SUPABASE_VIDEO_BUCKET: Storage bucket the clips go in. Create it in
# Supabase → Storage → New bucket, and mark it PUBLIC so visitors can play them.
SUPABASE_VIDEO_BUCKET="shop-videos"

# MAX_VIDEO_MB: Largest single upload accepted, in megabytes. Default 200.
MAX_VIDEO_MB="200"
