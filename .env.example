# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio → API keys).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production URL of this service (e.g. https://the-frame-shop.up.railway.app).
APP_URL="MY_APP_URL"

# SHOP_OWNER_PIN: The 4-digit PIN used to unlock the Shop Admin Portal.
# Set this to a real PIN in production — do NOT leave as 1234.
SHOP_OWNER_PIN="1234"

# SHOP_API_SECRET: Long random string used as the bearer token for admin API routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match between server env and be returned to the client after PIN validation.
SHOP_API_SECRET="generate-a-64-char-random-hex-string-here"

# STRIPE_SECRET_KEY: Stripe secret key (sk_live_... or sk_test_...).
# Found in Stripe Dashboard → Developers → API Keys.
# Required for online booking deposits and Stripe invoice sending.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Signing secret for Stripe webhook endpoint.
# Created in Stripe Dashboard → Developers → Webhooks → Add endpoint → Reveal signing secret.
# Point the endpoint to: https://your-domain.com/api/stripe/webhook
# Events to listen for: checkout.session.completed, invoice.paid
STRIPE_WEBHOOK_SECRET="whsec_..."

# VITE_STRIPE_PUBLISHABLE_KEY: Stripe publishable key (pk_live_... or pk_test_...).
# Safe to include in the frontend — cannot make charges on its own.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
